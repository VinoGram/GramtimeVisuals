/* ═══════════════════════════════════════════════════════════════════
   GRAMTIME VISUALS — ADMIN DASHBOARD
   AR/HUD Design System (matches main site)
═════════════════════════════════════════════════════════════════ */

:root {
  --hud-green: #4ade80;
  --hud-green-dim: rgba(74, 222, 128, 0.4);
  --hud-green-faint: rgba(74, 222, 128, 0.15);
  --hud-bg: #050505;
  --hud-panel: #0a0a0a;
  --hud-border: 1px solid rgba(74, 222, 128, 0.3);
  --hud-font: 'JetBrains Mono', monospace;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--hud-bg);
  color: #fff;
  font-family: var(--hud-font);
  min-height: 100vh;
}

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--hud-panel); }
::-webkit-scrollbar-thumb { background: var(--hud-green-dim); border-radius: 3px; }

/* ── Animations ── */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes hudPulse {
  0%, 100% { opacity: 0.6; }
  50%       { opacity: 1; }
}

@keyframes scanline {
  0%   { transform: translateY(-100%); }
  100% { transform: translateY(100vh); }
}

@keyframes glitchX {
  0%, 100% { transform: translateX(0); }
  20%       { transform: translateX(-3px); }
  40%       { transform: translateX(3px); }
  60%       { transform: translateX(-2px); }
  80%       { transform: translateX(2px); }
}

.ar-fade-in { animation: fadeIn 0.5s ease-out both; }
.hud-pulse { animation: hudPulse 2s ease-in-out infinite; }

/* ── Layout ── */
.admin-layout {
  display: flex;
  min-height: 100vh;
}

/* ── Sidebar ── */
.sidebar {
  width: 260px;
  background: var(--hud-panel);
  border-right: var(--hud-border);
  padding: 24px 0;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}

.sidebar-logo {
  padding: 0 24px 24px;
  border-bottom: var(--hud-border);
  margin-bottom: 16px;
}

.sidebar-logo h1 {
  font-size: 1.1rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.sidebar-logo span { color: var(--hud-green); }

.sidebar-logo p {
  font-size: 0.65rem;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 0.2em;
  margin-top: 4px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 24px;
  cursor: pointer;
  transition: all 0.2s;
  border-left: 2px solid transparent;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.nav-item:hover {
  background: var(--hud-green-faint);
  color: var(--hud-green);
}

.nav-item.active {
  background: var(--hud-green-faint);
  border-left-color: var(--hud-green);
  color: var(--hud-green);
}

.nav-item .icon {
  font-size: 1.1rem;
}

.sidebar-footer {
  margin-top: auto;
  padding: 16px 24px;
  border-top: var(--hud-border);
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.7rem;
  color: rgba(255, 255, 255, 0.4);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--hud-green);
  animation: hudPulse 2s ease-in-out infinite;
}

/* ── Main Content ── */
.main-content {
  flex: 1;
  padding: 32px 40px;
  overflow-y: auto;
}

/* ── Page Header ── */
.page-header {
  margin-bottom: 32px;
}

.page-header .breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}

.page-header .breadcrumb .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--hud-green);
  animation: hudPulse 2s ease-in-out infinite;
}

.page-header .breadcrumb span {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  color: var(--hud-green);
}

.page-header h2 {
  font-size: 2.5rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  animation: glitchX 0.4s ease;
}

.page-header h2 .accent {
  -webkit-text-stroke: 2px var(--hud-green);
  color: transparent;
}

.page-header .subtitle {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8px;
}

/* ── Stats Grid ── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}

.stat-card {
  background: var(--hud-panel);
  border: var(--hud-border);
  padding: 20px;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.stat-card:hover {
  box-shadow: 0 0 20px var(--hud-green-faint);
  transform: translateY(-2px);
}

.stat-card .label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
  margin-bottom: 8px;
}

.stat-card .value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--hud-green);
}

.stat-card .icon {
  position: absolute;
  top: 16px;
  right: 16px;
  font-size: 1.5rem;
  opacity: 0.2;
}

/* ── Filter Bar ── */
.filter-bar {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
  flex-wrap: wrap;
  align-items: center;
}

.filter-btn {
  padding: 8px 16px;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
  font-family: var(--hud-font);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s;
}

.filter-btn:hover {
  border-color: var(--hud-green-dim);
  color: var(--hud-green);
}

.filter-btn.active {
  background: var(--hud-green-faint);
  border-color: var(--hud-green);
  color: var(--hud-green);
  box-shadow: 0 0 12px var(--hud-green-faint);
}

.refresh-btn {
  margin-left: auto;
  padding: 8px 16px;
  background: transparent;
  border: 1px solid var(--hud-green-dim);
  color: var(--hud-green);
  font-family: var(--hud-font);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s;
}

.refresh-btn:hover {
  background: var(--hud-green-faint);
  box-shadow: 0 0 16px var(--hud-green-faint);
}

/* ── Consultation Cards ── */
.consultation-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.consultation-card {
  background: var(--hud-panel);
  border: var(--hud-border);
  padding: 24px;
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
  animation: fadeIn 0.4s ease-out both;
}

.consultation-card:hover {
  border-color: var(--hud-green-dim);
  box-shadow: 0 0 20px var(--hud-green-faint);
}

.consultation-card .scan-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--hud-green-dim), transparent);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 16px;
  flex-wrap: wrap;
  gap: 12px;
}

.card-header .ref-id {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: var(--hud-green);
}

.card-header .status-badge {
  padding: 4px 10px;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  border: 1px solid;
}

.status-pending {
  background: rgba(251, 191, 36, 0.1);
  border-color: rgba(251, 191, 36, 0.4);
  color: #fbbf24;
}

.status-confirmed {
  background: var(--hud-green-faint);
  border-color: var(--hud-green-dim);
  color: var(--hud-green);
}

.status-completed {
  background: rgba(96, 165, 250, 0.1);
  border-color: rgba(96, 165, 250, 0.4);
  color: #60a5fa;
}

.status-cancelled {
  background: rgba(248, 113, 113, 0.1);
  border-color: rgba(248, 113, 113, 0.4);
  color: #f87171;
}

.card-body {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.detail-group .label {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: rgba(255, 255, 255, 0.3);
  text-transform: uppercase;
  margin-bottom: 4px;
}

.detail-group .value {
  font-size: 0.85rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.card-footer {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.action-btn {
  padding: 6px 14px;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
  font-family: var(--hud-font);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.2s;
}

.action-btn:hover {
  border-color: var(--hud-green-dim);
  color: var(--hud-green);
}

.action-btn.danger:hover {
  border-color: rgba(248, 113, 113, 0.4);
  color: #f87171;
}

/* ── Empty State ── */
.empty-state {
  text-align: center;
  padding: 80px 20px;
}

.empty-state .icon {
  font-size: 3rem;
  opacity: 0.2;
  margin-bottom: 16px;
}

.empty-state h3 {
  font-size: 1.2rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 8px;
}

.empty-state p {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.3);
}

/* ── Loading ── */
.loading {
  text-align: center;
  padding: 60px;
  color: rgba(255, 255, 255, 0.4);
  font-size: 0.8rem;
  letter-spacing: 0.2em;
}

.loading .spinner {
  display: inline-block;
  width: 32px;
  height: 32px;
  border: 2px solid var(--hud-green-faint);
  border-top-color: var(--hud-green);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── Detail Modal ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(8px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  animation: fadeIn 0.2s ease;
}

.modal {
  background: var(--hud-panel);
  border: var(--hud-border);
  max-width: 600px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
}

.modal-header {
  padding: 24px;
  border-bottom: var(--hud-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-header h3 {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--hud-green);
}

.modal-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
  cursor: pointer;
  font-size: 1.2rem;
  transition: all 0.2s;
}

.modal-close:hover {
  background: rgba(248, 113, 113, 0.1);
  border-color: rgba(248, 113, 113, 0.4);
  color: #f87171;
}

.modal-body {
  padding: 24px;
}

.modal-body .detail-row {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.modal-body .detail-row .label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: rgba(255, 255, 255, 0.3);
  text-transform: uppercase;
}

.modal-body .detail-row .value {
  font-size: 0.85rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

/* ── Responsive ── */
@media (max-width: 768px) {
  .sidebar {
    width: 60px;
  }
  .sidebar-logo h1, .sidebar-logo p, .nav-item span, .sidebar-footer .status-indicator span {
    display: none;
  }
  .main-content {
    padding: 20px;
  }
  .page-header h2 {
    font-size: 1.8rem;
  }
}